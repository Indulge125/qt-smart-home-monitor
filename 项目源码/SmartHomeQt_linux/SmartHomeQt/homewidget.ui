    font-size: 14px;
    font-weight: 400;
}

QLabel#labelTemp, QLabel#labelHum, QLabel#labelLight,
QLabel#labelMqtt, QLabel#labelBoard, QLabel#labelLed {
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
}

QFrame#tempCard, QFrame#humCard, QFrame#lightCard,
QFrame#mqttCard, QFrame#boardCard, QFrame#ledCard,
QFrame#messageCard {
    background-color: #ffffff;
    border: 1px solid #e5eaf1;
    border-radius: 12px;
}

QLineEdit {
    background-color: #f8fafc;
    color: #172033;
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 20px;
    font-weight: 700;
    selection-background-color: #34c38f;
}

QLineEdit[readOnly=&quot;true&quot;] {
    background-color: #f8fafc;
    color: #172033;
}

QLineEdit:focus {
    border: 1px solid #34c38f;
}

QLabel#labelMessage {
    color: #15803d;
    font-size: 15px;
    font-weight: 600;
}</string>
