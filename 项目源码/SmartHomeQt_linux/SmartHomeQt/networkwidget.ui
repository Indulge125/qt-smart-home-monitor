   <string notr="true">QWidget {
    background-color: #f6f8fb;
    color: #1f2937;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 14px;
}

QLabel {
    background: transparent;
    color: #273445;
    font-weight: 500;
}

QLabel#labelTitle {
    color: #172033;
    font-size: 22px;
    font-weight: 700;
}

QLineEdit, QTextEdit, QComboBox {
    background-color: #ffffff;
    color: #202a3a;
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #34c38f;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #34c38f;
}

QLineEdit[readOnly=&quot;true&quot;], QTextEdit[readOnly=&quot;true&quot;] {
    background-color: #ffffff;
    color: #334155;
}

QPushButton {
    background-color: #34c38f;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    min-height: 34px;
    padding: 5px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #27ae7e;
}

QPushButton#btnBack, QPushButton#btnClear, QPushButton#btnDisconnect, QPushButton#btnReset {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #d9e1ec;
}

QPushButton#btnBack:hover, QPushButton#btnClear:hover, QPushButton#btnDisconnect:hover, QPushButton#btnReset:hover {
    background-color: #eefaf5;
    border-color: #34c38f;
    color: #34c38f;
}</string>
